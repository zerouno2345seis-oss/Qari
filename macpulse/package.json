{
  "name": "macpulse",
  "version": "0.2.0",
  "description": "Electron app for deep macOS performance monitoring and optimization",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.macpulse.app",
    "mac": { "category": "public.app-category.utilities" },
    "files": ["src/main/**", "dist-renderer/**", "package.json"]
  }
}
