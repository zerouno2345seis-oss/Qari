{
  "name": "macpulse",
  "version": "0.3.0",
  "description": "Electron app for deep macOS performance monitoring and optimization",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test",
    "dist": "npm run build && electron-builder --mac --publish never",
    "pack": "npm run build && electron-builder --mac --dir --publish never"
  },
  "dependencies": {
    "systeminformation": "^5.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^5.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.macpulse.app",
    "productName": "MacPulse",
    "artifactName": "MacPulse-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**",
      "dist-renderer/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "publish": null,
    "afterPack": "scripts/adhoc-sign.js"
  },
  "author": "MacPulse"
}
